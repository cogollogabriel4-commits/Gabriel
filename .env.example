# Conexión a PostgreSQL
DATABASE_URL="postgresql://expedientes:cambia-esta-clave@localhost:5432/expedientes"
# Clave para firmar las sesiones: genera una con `openssl rand -base64 48`
SESSION_SECRET="cambia-esto-por-una-clave-larga-y-aleatoria"
# Carpeta donde se guardan los archivos (fuera de la carpeta pública)
UPLOAD_DIR="./almacen"
# Primer administrador (usado por `npm run db:seed`)
ADMIN_NOMBRE="Carlos Cogollo"
ADMIN_CORREO="admin@ejemplo.com"
ADMIN_CLAVE="cambia-esta-clave"
# Dominio para HTTPS automático con Caddy (solo docker-compose)
DOMINIO="expedientes.ejemplo.com"
POSTGRES_PASSWORD="cambia-esta-clave"
